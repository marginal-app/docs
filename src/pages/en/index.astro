---
// Landing — layout mirrors the Figma frame "랜딩 v2 · 프로덕트" (Web · / page).
import '../../styles/tokens.css';
const title = 'Marginal — The quietest way to remember what you read';
const description = 'Select a sentence on the web to highlight it and build a table of contents. Saved to your browser first, and synced everywhere when you connect your server.';
const features = [
  { icon: 'highlighter', title: 'Five highlight colors', body: 'Select a sentence to open the color toolbar. Choose from five pastel colors and decide what each means to you.' },
  { icon: 'comment', title: 'Comments in the margin', body: 'Add a short note beside a highlight. Continue editing the same comment in the side panel or on the web.' },
  { icon: 'list', title: 'A table of contents, not a table', body: 'Pages you mark become a numbered table of contents. Select an entry to open its highlights alongside it.' },
  { icon: 'bookmark', title: 'Bookmarks', body: 'Keep a page in your contents without highlighting it—the lightest way to mark where you want to return.' },
  { icon: 'local', title: 'Local-first', body: 'The extension works fully without a server. Your highlights are always saved to the browser first.' },
  { icon: 'server', title: 'Self-hosted sync', body: 'One Django server gives you the same contents everywhere. Your data never leaves your server.' },
];
const icons: Record<string, string> = {
  highlighter: 'm9 11-6 6v3h9l3-3M22 12l-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4',
  comment: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  list: 'M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01',
  bookmark: 'm19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z',
  local: 'M21 4h-8M9 4H3M21 12h-6M11 12H3M21 20h-4M13 20H3M13 2v4M15 10v4M17 18v4',
  server: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z',
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="ko" href="/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/screens/home.png" />
  </head>
  <body>
    <header class="nav">
      <a class="wordmark" href="/en/"><span class="rule"></span>Marginal</a>
      <nav>
        <a href="#features">Features</a>
        <a href="/en/self-host/server/">Self-host</a>
        <a href="/en/getting-started/install/">Docs</a>
        <a href="https://github.com/marginal-app/marginal-app">GitHub</a>
        <a href="/" lang="ko" hreflang="ko">한국어</a>
        <a class="btn primary" href="/en/getting-started/install/">Install extension</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <span class="pill">Open source · Self-hosted · Local-first</span>
        <h1>The quietest way to<br />remember what you read</h1>
        <p class="lead">Select a sentence on the web to highlight it and build a table of contents.<br />Saved to your browser first, and synced everywhere when you connect your server.</p>
        <div class="ctas">
          <a class="btn primary lg" href="/en/getting-started/install/">Install for Chrome — free</a>
          <a class="btn quiet lg" href="/en/self-host/server/">Run your server →</a>
        </div>
        <p class="trust">Chrome · Firefox · No account needed · Data stays in your browser and on your server</p>
      </section>

      <section class="shot">
        <div class="band"></div>
        <img class="desk" src="/screens/home.png" width="1024" height="646" alt="Marginal home screen with sidebar, highlights from this week, recent highlights, and frequently revisited pages" />
        <img class="panel" src="/screens/panel-saving.png" width="360" height="560" alt="Side panel showing a new highlight being saved" />
      </section>

      <section class="features" id="features">
        <p class="eyebrow">FEATURES</p>
        <h2>A reading record that starts with one highlight</h2>
        <p class="lead">No complex setup—just select some text.</p>
        <div class="grid">
          {features.map((f) => (
            <article class="card">
              <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons[f.icon]} /></svg></span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="alt">
        <div class="copy">
          <p class="eyebrow">IN THE BROWSER</p>
          <h2>Right where you are reading</h2>
          <p class="lead">Select text for the color toolbar and choose a highlight to add a comment. The side panel collects every highlight from the page.</p>
          <ul>
            <li>Five colors, one click</li>
            <li>Comments in a popover beside the highlight</li>
            <li>Clear Saving → Synced states</li>
          </ul>
        </div>
        <figure class="media paper"><img src="/screens/overlays.png" width="520" height="560" alt="Color toolbar and comment popover over the page" /></figure>
      </section>

      <section class="alt reverse">
        <div class="copy">
          <p class="eyebrow">ON THE WEB</p>
          <h2>A table of contents for pages you mark</h2>
          <p class="lead">Home shows this week and recent highlights. The library numbers your pages like a table of contents. Select one to open a tray while keeping the list in view.</p>
          <ul>
            <li>Contents · Highlights · Bookmarks · Comments</li>
            <li>Edit comments directly in the tray</li>
            <li>A collapsible sidebar</li>
          </ul>
        </div>
        <figure class="media"><img src="/screens/library-tray.png" width="1024" height="484" alt="Library screen with a contents entry selected and its tray open on the right" /></figure>
      </section>

      <section class="local">
        <p class="eyebrow">LOCAL FIRST</p>
        <h2>Works without a server—and everywhere with one</h2>
        <p class="lead">Highlights are always saved to your browser first. The server is optional.</p>
        <div class="two">
          <article class="card">
            <h3>Local only</h3>
            <p>Without a token, there are no sync indicators or web buttons. Your data quietly stays in your browser.</p>
            <img src="/screens/panel-local.png" width="360" height="560" alt="Local-only side panel" />
          </article>
          <article class="card">
            <h3>Sync with my server</h3>
            <p>Highlights appear immediately and change from Saving → Synced in the background. Failures appear only for server errors.</p>
            <img src="/screens/panel-synced.png" width="360" height="560" alt="Synced side panel" />
          </article>
        </div>
      </section>

      <section class="cta">
        <div class="banner">
          <h2>Remember what you read today</h2>
          <p>Free · Open source · No account required. Connect a server whenever you are ready.</p>
          <div class="ctas">
            <a class="btn onaccent lg" href="/en/getting-started/install/">Install for Chrome</a>
            <a class="btn outline lg" href="https://github.com/marginal-app/marginal-app">View on GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <a class="wordmark" href="/en/"><span class="rule"></span>Marginal</a>
      <nav>
        <a href="/en/getting-started/install/">docs.marginal.app</a>
        <a href="/en/self-host/server/">Self-hosting guide</a>
        <a href="https://github.com/marginal-app/marginal-app">GitHub</a>
        <span>MIT License</span>
      </nav>
    </footer>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html { color-scheme: light; }
  body { margin: 0; font-family: var(--font-sans); font-size: 15px; line-height: 1.5; color: var(--text); background: var(--bg); -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3 { margin: 0; letter-spacing: -0.02em; }
  main { display: flex; flex-direction: column; }
  section { padding-inline: clamp(16px, 4.5vw, 64px); }

  .wordmark { display: inline-flex; flex-direction: column; gap: 4px; font-family: var(--font-serif-latin); font-size: 20px; }
  .wordmark .rule { width: 28px; height: 2px; background: var(--accent); }

  .nav { display: flex; justify-content: space-between; align-items: center; padding: 20px clamp(16px, 4.5vw, 64px); }
  .nav nav, footer nav { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; font-size: 13px; font-weight: 500; color: var(--text-secondary); }

  .btn { display: inline-flex; align-items: center; justify-content: center; padding: 8px 14px; border-radius: var(--radius); font-size: 13px; font-weight: 500; border: 1px solid transparent; white-space: nowrap; }
  .btn.lg { padding: 12px 20px; font-size: 14px; }
  .btn.primary { background: var(--accent); color: var(--accent-text); border-color: color-mix(in srgb, var(--accent) 78%, #000); }
  .btn.quiet { border-color: var(--border); color: var(--text); }
  .btn.onaccent { background: var(--bg); color: var(--accent); }
  .btn.outline { border-color: var(--accent-text); color: var(--accent-text); }

  .eyebrow { margin: 0 0 12px; font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .lead { margin: 12px 0 0; font-size: 17px; line-height: 1.6; color: var(--text-secondary); }
  h2 { font-size: clamp(24px, 3vw, 32px); }

  .hero { padding-top: 96px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .hero h1 { font-size: clamp(34px, 5vw, 52px); line-height: 1.15; font-weight: 700; letter-spacing: -0.02em; }
  .hero .lead { margin: 0; max-width: 640px; }
  .pill { padding: 5px 12px; border-radius: 999px; background: var(--bg-elevated); border: 1px solid var(--border); font-size: 13px; font-weight: 500; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; padding-top: 8px; }
  .trust { margin: 0; font-size: 13px; color: var(--text-secondary); }

  .shot { position: relative; height: clamp(420px, 60vw, 820px); overflow: hidden; margin-top: 40px; }
  .shot .band { position: absolute; left: 0; right: 0; top: 30%; bottom: 0; background: var(--bg-elevated); }
  .shot .desk { position: absolute; left: 50%; top: 16px; transform: translateX(-50%); width: min(1120px, 88vw); height: auto; border-radius: 12px; box-shadow: 0 1px 2px rgba(20,20,30,.04), 0 24px 60px rgba(20,20,30,.12); }
  .shot .panel { position: absolute; right: clamp(16px, 11vw, 160px); top: 36%; width: min(360px, 40vw); height: auto; border-radius: 12px; box-shadow: 0 1px 2px rgba(20,20,30,.04), 0 24px 60px rgba(20,20,30,.16); }

  .features { padding-top: 96px; padding-bottom: 72px; text-align: center; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 48px; text-align: left; }
  .card { background: var(--bg-elevated); border-radius: var(--radius); padding: 24px; }
  .card h3 { font-size: 14px; font-weight: 500; margin-top: 12px; }
  .card p { margin: 8px 0 0; font-size: 13px; line-height: 1.55; color: var(--text-secondary); }
  .tile { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 8px; background: var(--bg); border: 1px solid var(--border); color: var(--accent); }

  .alt { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 64px; align-items: center; padding-block: 72px; }
  .alt.reverse .copy { order: 2; }
  .alt ul { margin: 16px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .alt li::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-right: 10px; vertical-align: middle; }
  .media { margin: 0; display: flex; align-items: center; justify-content: center; background: var(--bg-elevated); border-radius: var(--radius); padding: 32px; min-height: 420px; }
  .media.paper { background: var(--paper); }
  .media img { max-width: 100%; height: auto; border-radius: 12px; box-shadow: 0 1px 2px rgba(20,20,30,.04), 0 16px 40px rgba(20,20,30,.1); }

  .local { background: var(--bg-elevated); padding-block: 72px 96px; text-align: center; }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 48px; text-align: left; }
  .local .card { background: var(--bg); border: 1px solid var(--border); padding: 32px 32px 0; overflow: hidden; display: flex; flex-direction: column; align-items: center; }
  .local .card h3 { font-size: 24px; font-weight: 600; align-self: stretch; }
  .local .card p { font-size: 14px; align-self: stretch; }
  .local .card img { width: 360px; max-width: 100%; height: auto; margin-top: 20px; border-radius: 12px 12px 0 0; box-shadow: 0 1px 2px rgba(20,20,30,.04), 0 16px 40px rgba(20,20,30,.1); }

  .cta { padding-block: 24px 96px; }
  .banner { background: var(--accent); color: var(--accent-text); border-radius: 16px; padding: 64px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .banner p { margin: 0; font-size: 17px; opacity: .85; }

  footer { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding: 24px clamp(16px, 4.5vw, 64px) 32px; border-top: 1px solid var(--border); }

  @media (max-width: 860px) {
    .grid, .two, .alt { grid-template-columns: 1fr; }
    .alt.reverse .copy { order: 0; }
    .shot .panel { display: none; }
    .nav nav a:not(.btn) { display: none; }
  }
</style>
